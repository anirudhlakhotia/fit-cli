# Copy this file to .env and fill in your AWS credentials to run FIT on a clean
# EC2 instance. The file is git-ignored. If you already have working AWS config
# (env vars or ~/.aws/credentials), you don't need this — those take precedence.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional: use a named profile from ~/.aws/credentials instead of keys above.
# AWS_PROFILE=

# Optional: override the EC2 instance type used for FIT runs (default c5.xlarge).
# FIT_EC2_INSTANCE_TYPE=c5.xlarge
