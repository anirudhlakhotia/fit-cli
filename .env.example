# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# fit-cli loads `.env` at startup; real exported environment variables win over it.

# Readonly password for the hosted situational/perf results database on
# faas.couchbase.com. Ask for it on the #the-fit-stop Slack channel.
# Needed only when you choose the hosted (recommended) results database, and
# only reachable on the vpn-public VPN.
FIT_RESULTS_DB_PASSWORD=

# Optional — override the hosted results-DB username (defaults to "postgres").
#FIT_RESULTS_DB_USERNAME=postgres
