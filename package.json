{
  "name": "fit-cli",
  "version": "0.1.0",
  "description": "A CLI tool to help make FIT (Functional Integration Testing) easier to use.",
  "type": "module",
  "bin": {
    "fit": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "replay": "tsx src/util/non-fit/replay-entry.ts --replay",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test 'src/**/tests/*.test.ts'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1"
  }
}
