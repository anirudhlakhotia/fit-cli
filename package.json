{
  "name": "fit-cli",
  "version": "0.1.0",
  "description": "A CLI tool to help make FIT (Functional Integration Testing) easier to use.",
  "type": "module",
  "bin": {
    "fit": "./dist/index.js"
  },
  "scripts": {
    "help": "printf 'Top-level commands:\\n  npm start               — interactive wizard\\n  npm run config          — manage configuration\\n  npm run definition      — run/validate a definition file\\n  npm run cloud-instances — manage cloud instances\\n'",
    "start": "tsx src/fit/main/main.ts",
    "config": "tsx src/fit/config/config.ts",
    "replay": "tsx src/util/non-fit/replay-entry.ts --replay",
    "definition": "tsx src/fit/definition/definition.ts",
    "cloud-instances": "tsx src/cloud/cloud-instances/cloud-instances.ts",
    "dev": "tsx watch src/fit/main/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test 'src/**/tests/*.test.ts'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "json5": "^2.2.3",
    "xunit-viewer": "^10.6.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1"
  }
}
