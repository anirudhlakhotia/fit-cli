{
  "name": "fit-cli",
  "version": "0.1.0",
  "description": "A CLI tool to help make FIT (Functional Integration Testing) easier to use.",
  "type": "module",
  "bin": {
    "fit": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "init": "tsx src/init.ts",
    "replay": "tsx src/util/non-fit/replay-entry.ts --replay",
    "definition": "tsx src/workflows/fit-functional/run-from-definition/run-from-definition.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test 'src/**/tests/*.test.ts'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "xunit-viewer": "^10.6.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1"
  }
}
