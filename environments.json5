{
  // Per-environment registry plus global defaults. Holds only NON-secret values
  // plus a POINTER (secretId) to where the secrets live in AWS Secrets Manager —
  // no secret values are committed.
  //
  // Which environment a run uses is chosen in the definition file:
  //   capella  → instances[*].setup.capellaEnvironment   (default 'prod')
  //   results  → runs[*].situational.database.resultsEnvironment   (default 'dev')
  //
  // Only the passwords live in AWS Secrets Manager now (us-west-2); everything else
  // (endpoint, oid, the shared Capella username, results host) is non-secret and lives here.
  // Secrets are fetched at run time using the same AWS credentials fit-cli already needs to
  // create instances — so CI and laptops resolve identically. Access is controlled purely by
  // IAM on the secrets (CI's fit-cli-role + developers' SSO role need secretsmanager:GetSecretValue).
  //   capella secret JSON → { "password": "..." }
  //   results secret JSON → { "password": "..." }   (username defaults to "postgres")
  //
  // Capella password: a developer's own (from `config edit` / CAPELLA_PASS env) takes precedence
  // locally; with none configured we fall back to the shared account password in the secret (and
  // warn). The username is the shared account below unless overridden. Results creds always from the secret.
  //
  // A null non-secret value means "not yet provided" — selecting that block fails fast.
  // bun run secrets set capella/dev password='<password>'
  // bun run secrets set results/dev password='<password>'

  // Global defaults — not per-environment. Version strings passed to cbdinocluster
  // (and related tools) when the definition file doesn't pin them explicitly.
  defaults: {
    // Default Couchbase Server version passed to cbdinocluster. Accepts stable-channel
    // aliases (e.g. "8.0-stable") as well as pinned builds (e.g. "8.0.2-5322") — use
    // a pinned build if you need a specific patch or the alias is temporarily broken.
    clusterVersion: "8.0-stable",

    // CNG generally uses OpenShift which uses server builds from cb-rhcc (rather than
    // cb-vanilla). The same builds _should_ be available on both, but see:
    // https://couchbase.slack.com/archives/C04DB7P157T/p1781783413258219
    // Ideally this would track clusterVersion, but that version does not exist on cb-rhcc currently.
    cngClusterVersion: "8.0.2-5503",

    // Default self-managed Enterprise Analytics build passed to cbdinocluster.
    enterpriseAnalyticsVersion: "2.2.0-1166",

    // Default Couchbase Autonomous Operator version for CNG/Protostellar support
    // (the ROSA/cao deployer).
    caoOperatorVersion: "2.9.2",

    // The Cloud Native Gateway (Protostellar gateway) version, the cao block's `gateway-version`.
    cngVersion: "1.1.0-135",

    // Default Capella environment (a key under `capella` below) when the definition file doesn't specify one.
    // This is the default because we've seen issues on dev (https://couchbase.slack.com/archives/C05LNBVQRE3/p1782487819678329)
    // That will hopefully be better on prod.
    defaultCapellaEnvironment: "prod",

    // Default results environment (a key under `results` below) when the definition file doesn't specify one.
    // This is the database and UI for FIT/SIT and FIT/PERF results.
    defaultResultsEnvironment: "prod",
  },

  capella: {
    prod: {
      endpoint: "https://api.cloud.couchbase.com",
      oid: "62488bdd-d416-467e-84f7-fc7c1583a083",
      username: "sdk_qe@couchbase.com",
      secretId: "fit-cli/capella/prod",
    },
    dev: {
      endpoint: "https://api.dev.nonprod-project-avengers.com",
      oid: "6af08c0a-8cab-4c1c-b257-b521575c16d0",
      username: "sdk_qe@couchbase.com",
      secretId: "fit-cli/capella/dev",
    },
  },
  results: {
    // hosted-dev: Postgres results DB on :5432/perf, results UI under /results/situational.
    dev: { host: "faas.couchbase.com", secretId: "fit-cli/results/dev" },
    // production results.
    prod: { host: "performance-sdk.couchbase.com", secretId: "fit-cli/results/prod" },
  },
}
