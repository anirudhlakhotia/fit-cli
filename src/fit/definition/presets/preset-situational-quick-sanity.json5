{
  preset: {
    order: 12,
    description: 'Quick sanity testing for situational tests against a given SDK.',
    expectedTime: '< 10 minutes'
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      setup: {
        capellaEnvironment: 'dev',
      },
      // FIT/SIT creates its own clusters, so none are set up here.
      clusters: [],
      // Sessions not tied to any particular cluster.
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                classes: ['com.couchbase.situational.tests.SanityTest'],
              },
              situational: {
                database: {
                  mode: 'hosted',
                  resultsEnvironment: 'dev',
                },
              },
            },
          ],
        },
      ],
    },
  ],
}
