// Preset: This is the set SDKQE-that-was like to run before signing off on a release.
{
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      setup: {
        cbdinocluster: {
          init: {
            // Passed to `cbdinocluster init` on clean environments to set up ~/.cbdinocluster.
            // On localhost, init is skipped and your existing ~/.cbdinocluster is used as-is.
            // Edit to taste; fit-cli appends your GitHub credentials at runtime.
            args: '--auto --aws-region us-west-2 --disable-azure --disable-gcp --disable-k8s --disable-dns --docker-network fit',
          },
        },
        capellaEnvironment: 'dev',
      },
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  fitConfig: 'fit-config-functional',
                  tests: {
                    presets: ['all'],
                  },
                },
              ],
            },
          ],
        },
      ],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              fitConfig: 'fit-config-situational',
              tests: {
                presets: ['standard-qe'],
              },
              situational: {
                database: {
                  mode: 'hosted',
                  resultsEnvironment: 'dev',
                },
              },
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        // Reuse an existing cbdinocluster cluster if one is already running (avoids re-creating on resume).
        onClusterExists: 'useExisting',
      },
    },
  ],
  fitConfigs: [
    {
      id: 'fit-config-functional',
      config: {
        // fit-cli fills ${defaultHostname} (and rest.hostname) in at runtime once the cluster is up.
        clusterAccess: {
          connectionString: 'couchbase://${defaultHostname}',
          username: 'Administrator',
          password: 'password',
          tls: null,
          rest: {
            hostname: '${defaultHostname}',
            resolveDnsSrv: false,
          },
          proxy: {
            hostname: 'host.docker.internal',
          },
        },
        // fit-cli will inject performerPorts at runtime.
        excludeTests: ['situational'],
      },
    },
    {
      id: 'fit-config-situational',
      config: {
        // Ignored for situational-only runs — cbdino creates and manages the cluster.
        clusterAccess: {
          defaultHostname: 'localhost',
          username: 'Administrator',
          password: 'password',
        },
        // fit-cli will inject performerPorts at runtime.
        excludeTests: [],
        situational: {
          cbdino: {
            version: '7.6',
            enablePrivateEndpoint: false,
          },
        },
      },
    },
  ],
}
