// Preset: does quick sanity testing across all testing axes against a given SDK.
{
  version: 1,
  type: 'fit',
  description: 'Quick sanity — operational functional, CNG functional, and situational',
  instances: [
    // Instance 1: operational functional SanityTest + situational sanity (shared Docker instance)
    {
      aws: {},
      setup: {
        capellaEnvironment: 'dev',
      },
      clusters: [
        {
          clusterConfig: 'cluster-operational',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    classes: ['com.couchbase.client.kv.SanityTest'],
                  },
                },
              ],
            },
          ],
        },
      ],
      // FIT/SIT creates its own clusters, so none are configured here.
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                classes: ['com.couchbase.situational.tests.SanityTest'],
              },
              situational: {
                database: {
                  mode: 'hosted',
                  resultsEnvironment: 'dev',
                },
              },
            },
          ],
        },
      ],
    },

    // Instance 2: CNG functional SanityTest on OpenShift (ROSA)
    // Will add back when CNG testing is stable.
    /*
    {
      aws: {},
      setup: {
        cbdinocluster: {
          init: {
            // CNG uploads this config verbatim as ~/.cbdinocluster. fit-cli adds the
            // `k8s` block (pointing at the logged-in OpenShift context) and your
            // GitHub credentials at runtime, so they stay out of this file. Unlike the
            // docker preset there is no `--disable-k8s`: the cao deployer needs k8s.
            config: {
              version: 6,
              docker: {
                enabled: true,
                network: 'fit',
                host: 'unix:///var/run/docker.sock',
              },
            },
          },
        },
      },
      clusters: [
        {
          clusterConfig: 'cluster-cng',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  fitConfig: 'fit-config-cng',
                  tests: {
                    classes: ['com.couchbase.client.kv.SanityTest'],
                    // protostellarWillWorkLater is a known-broken Maven group on CNG;
                    // added on top of the default functional exclusions.
                    addToDefaultExcludedGroups: ['protostellarWillWorkLater'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
    */
  ],
  clusterConfigs: [
    {
      id: 'cluster-operational',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
    {
      id: 'cluster-cng',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          // The `cao` block makes this a CNG cluster: fit-cli uses the cao deployer,
          // enables ingresses, and creates the default bucket via REST (cbdinocluster
          // can't do that for cao yet). Override the versions here if needed.
          cao: {
            'operator-version': '2.9.2',
            'gateway-version': '1.1.0-135',
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],
}
