{
  preset: {
    order: 10,
    description: 'run all FIT functional tests for a given SDK.',
    expectedTime: 'TBD',
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['all'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        // Reuse an existing cbdinocluster cluster if one is already running (avoids re-creating on resume).
        onClusterExists: 'useExisting',
      },
    },
  ],
}
