{
  preset: {
    order: 10,
    description: 'Run all FIT functional tests for a given SDK.',
    expectedTime: '< 1 hour',
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      clusters: [
        {
          clusterConfig: '8.0-stable',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['all'],
                  },
                },
              ],
            },
          ],
        },
        {
          clusterConfig: '7.6-stable',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['all'],
                  },
                },
              ],
            },
          ],
        }
      ],
    },
  ],
  clusterConfigs: [
    {
      id: '8.0-stable',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
    {
      id: '7.6-stable',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '7.6-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    }
  ],
}
