{
  preset: {
    order: 15,
    description: 'Quick sanity testing across all testing axes against a given SDK.',
    expectedTime: '< 30 minutes',
  },
  version: 1,
  type: 'fit',
  description: 'Quick sanity — operational functional, CNG functional, and situational',
  instances: [
    // Instance 1: operational functional SanityTest + situational sanity (shared Docker instance)
    {
      aws: {},
      setup: {
        capellaEnvironment: 'dev',
      },
      clusters: [
        {
          clusterConfig: 'cluster-operational',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    classes: ['com.couchbase.client.kv.SanityTest'],
                  },
                },
              ],
            },
          ],
        },
      ],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                classes: ['com.couchbase.situational.tests.SanityTest'],
              },
              situational: {
                database: {
                  mode: 'hosted',
                  resultsEnvironment: 'dev',
                },
              },
            },
          ],
        },
      ],
    },

    // Instance 2: CNG functional SanityTest on OpenShift (ROSA)
    // Will add back when CNG testing is stable.
    /*
    {
      aws: {},
      clusters: [
        {
          clusterConfig: 'cluster-cng',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  fitConfig: 'fit-config-cng',
                  tests: {
                    classes: ['com.couchbase.client.kv.SanityTest'],
                    // protostellarWillWorkLater is a known-broken Maven group on CNG;
                    // added on top of the default functional exclusions.
                    addToDefaultExcludedGroups: ['protostellarWillWorkLater'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
    */
  ],
  clusterConfigs: [
    {
      id: 'cluster-operational',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
    {
      id: 'cluster-cng',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          cao: {
            'operator-version': '2.9.2',
            'gateway-version': '1.1.0-135',
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],
}
