// Preset: run all FIT functional tests for a given SDK against a CNG / Protostellar
// Currently that runs against ROSA OpenShift, but that could change in future
{
  version: 1,
  type: 'fit',
  description: 'CNG functional tests',
  instances: [
    {
      aws: {},
      setup: {
        cbdinocluster: {
          init: {
            // CNG uploads this config verbatim as ~/.cbdinocluster. fit-cli adds the
            // `k8s` block (pointing at the logged-in OpenShift context) and your
            // GitHub credentials at runtime, so they stay out of this file. Unlike the
            // docker preset there is no `--disable-k8s`: the cao deployer needs k8s.
            config: {
              version: 6,
              docker: {
                enabled: true,
                network: 'fit',
                host: 'unix:///var/run/docker.sock',
              },
            },
          },
        },
      },
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  fitConfig: 'fit-config-0',
                  tests: {
                    presets: ['all'],
                    // protostellarWillWorkLater is a known-broken Maven group on CNG;
                    // the rest mirror the default functional exclusions.
                    excludedGroups: [
                      'situational',
                      'openshift',
                      'syncgateway',
                      'protostellarWillWorkLater',
                    ],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          // The `cao` block makes this a CNG cluster: fit-cli uses the cao deployer,
          // enables ingresses, and creates the default bucket via REST (cbdinocluster
          // can't do that for cao yet). Override the versions here if needed.
          cao: {
            'operator-version': '2.9.2',
            'gateway-version': '1.1.0-135',
          },
        },
        // Reuse an existing cbdinocluster cluster if one is already running (avoids re-creating on resume).
        onClusterExists: 'useExisting',
      },
    },
  ],
  fitConfigs: [
    {
      id: 'fit-config-0',
      config: {
        // fit-cli generates the CNG clusterAccess at runtime once the cluster is up:
        // the performer connects over couchbase2:// (insecure TLS), the test-driver
        // admin uses classic couchbase://, REST goes via the ui<ingress>, and proxy +
        // ssh are null. The default bucket is left to the FIT test-driver to create.
        excludeTests: ['situational', 'ssh', 'openshift'],
      },
    },
  ],
}
