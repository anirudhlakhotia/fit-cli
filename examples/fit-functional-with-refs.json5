// Example showing reusable clusterConfig and fitConfig references.
//
// The bottom-level clusterConfigs and fitConfigs sections hold named definitions
// that can be referenced by id from instances[].clusters[].clusterConfig and
// sessions[].runs[].fitConfig respectively.  This avoids repeating the same
// cbdinocluster config or FITConfiguration template across multiple instances.
//
// Validate / run with:
//   npm run definition -- validate examples/fit-functional-with-refs.json5
//   npm run definition -- execute --interactive examples/fit-functional-with-refs.json5
{
  version: 1,
  type: 'fit',

  instances: [
    {
      aws: {},
      clusters: [
        {
          clusterConfig: 'cluster-aws', // resolved from clusterConfigs below
          sessions: [
            {
              performer: {
                sdk: 'java',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  fitConfig: 'fit-config-0', // resolved from fitConfigs below
                  tests: {
                    run: ['com.couchbase.client.kv.SanityTest'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
    {
      localhost: {},
      clusters: [
        {
          clusterConfig: 'cluster-local',
          sessions: [
            {
              performer: {
                sdk: 'java',
              },
              runs: [
                {
                  type: 'functional',
                  fitConfig: 'fit-config-0', // reuse same fitConfig across runs
                  tests: {
                    run: 'all',
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],

  // Reusable cluster definitions (referenced by id above)
  clusterConfigs: [
    {
      id: 'cluster-aws',
      cbdinocluster: {
        init: {
          // This file will be uploaded verbatim into clean environments as ~/.cbdinocluster
          config: {
            version: 6,
            docker: {
              enabled: true,
              network: 'fit',
              host: 'unix:///var/run/docker.sock',
            },
          },
        },
        config: {
          nodes: [
            {
              count: 3,
              version: '8.1.0-2188',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
        },
        onClusterExists: 'useExisting',
      },
    },
    {
      id: 'cluster-local',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 1,
              version: '8.1.0-2188',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
        },
      },
    },
  ],

  // Each fitConfig is used as a base when generating FITConfiguration.json.  Anything here will be copied into the config (unless overwritten by fit-cli).
  // fit-cli will provide some fields like ${defaultHostname} at runtime when cluster details are known.
  fitConfigs: [
    {
      id: 'fit-config-0',
      config: {
        clusterAccess: {
          connectionString: 'couchbase://${defaultHostname}',
          username: 'Administrator',
          password: 'password',
          tls: null,
          rest: {
            hostname: '${defaultHostname}',
            resolveDnsSrv: false,
          },
          proxy: {
            hostname: 'host.docker.internal',
          },
        },
        excludeTests: ['situational'],
      },
    },
  ],
}
