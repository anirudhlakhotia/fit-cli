// Runs a single SanityTest test file against a single SDK, in a clean environment.
// Run with:
// npm run definition -- --interactive examples/fit-functional-sanity-test.json5
{
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      clusters: [
        {
          cbdinocluster: {
            init: {
              // Passed to `cbdinocluster init` on clean environments to set up ~/.cbdinocluster.
              // Edit to taste; fit-cli appends your GitHub credentials at runtime.
              args: '--auto --disable-aws --disable-azure --disable-capella --disable-gcp --disable-k8s --disable-dns --docker-network fit',
            },
            config: {
              nodes: [
                {
                  count: 3,
                  version: '8.1.0-2188',
                  services: ['kv', 'n1ql', 'index', 'fts'],
                },
              ],
            },
            onClusterExists: 'useExisting',
          },
          sessions: [
            {
              performer: {
                sdk: 'java',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  // This will be used as a base when generating FITConfiguration.json.  Anything here will be copied into the config (unless overwritten by fit-cli).
                  fitConfig: {
                    clusterAccess: {
                      connectionString: 'couchbase://${defaultHostname}',
                      username: 'Administrator',
                      password: 'password',
                      tls: null,
                      rest: {
                        hostname: '${defaultHostname}',
                        resolveDnsSrv: false,
                      },
                      proxy: {
                        hostname: 'host.docker.internal',
                      },
                    },
                    excludeTests: ['situational'],
                  },
                  tests: {
                    run: ['com.couchbase.client.kv.SanityTest'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
}
