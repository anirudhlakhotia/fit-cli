// Runs a single SanityTest test file against a single SDK, in a clean environment.
//
// The cluster and fitConfig definitions are split out into the bottom-level
// clusterConfigs and fitConfigs sections and referenced by id, which keeps the
// instances list short and lets the same definitions be reused across runs.
//
// Validate / run with:
//   npm run definition -- validate examples/fit-functional-sanity-test.json5
//   npm run definition -- execute --interactive examples/fit-functional-sanity-test.json5
{
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      setup: {
        cbdinocluster: {
          init: {
            // Passed to `cbdinocluster init` on clean environments to set up ~/.cbdinocluster.
            // Edit to taste; fit-cli appends your GitHub credentials at runtime.
            args: '--auto --disable-aws --disable-azure --disable-capella --disable-gcp --disable-k8s --disable-dns --docker-network fit',
          },
        },
      },
      clusters: [
        {
          clusterConfig: 'cluster-clean', // resolved from clusterConfigs below
          sessions: [
            {
              performer: {
                sdk: 'java',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  fitConfig: 'fit-config-0', // resolved from fitConfigs below
                  tests: {
                    run: ['com.couchbase.client.kv.SanityTest'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],

  // Reusable cluster definitions (referenced by id above).
  clusterConfigs: [
    {
      id: 'cluster-clean',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.1.0-2188',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],

  // Reusable fitConfig definitions (referenced by id above).
  // Each is used as a base when generating FITConfiguration.json. Anything here will be
  // copied into the config (unless overwritten by fit-cli), and fit-cli fills in fields
  // like ${defaultHostname} at runtime once cluster details are known.
  fitConfigs: [
    {
      id: 'fit-config-0',
      config: {
        clusterAccess: {
          connectionString: 'couchbase://${defaultHostname}',
          username: 'Administrator',
          password: 'password',
          tls: null,
          rest: {
            hostname: '${defaultHostname}',
            resolveDnsSrv: false,
          },
          proxy: {
            hostname: 'host.docker.internal',
          },
        },
        excludeTests: ['situational'],
      },
    },
  ],
}
