// Runs a single SanityTest test file against a single SDK, in a clean environment.
//
// The cluster and fitConfig definitions are split out into the bottom-level
// clusterConfigs and fitConfigs sections and referenced by id, which keeps the
// instances list short and lets the same definitions be reused across runs.
//
// Validate / run with:
//   bun run definition validate examples/fit-functional-sanity-test.json5
//   bun run definition execute --interactive examples/fit-functional-sanity-test.json5
{
  version: 1,
  type: 'fit',
  description: '{AWS:{cbdino(3n@8.0-stable):[{Java@latest,functional,SanityTest}]}}',
  instances: [
    {
      aws: {},
      setup: {
        cbdinocluster: {
          init: {
            // Passed to `cbdinocluster init` on clean environments to set up ~/.cbdinocluster.  Added at runtime: GitHub creds
            args: '--auto --disable-aws --disable-azure --disable-capella --disable-gcp --disable-k8s --disable-dns --docker-network fit',
          },
        },
      },
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                sdk: 'java',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  fitConfig: 'fit-config-0',
                  tests: {
                    classes: [
                      'com.couchbase.client.kv.SanityTest',
                    ],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',  // resolved by fit-cli at runtime
              services: [
                'kv',
                'n1ql',
                'index',
                'fts',
              ],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],
  // Each fitConfig is used as a base when generating FITConfiguration.json.  Anything here will be copied into the config (unless overwritten by fit-cli).
  // fit-cli will provide some fields like ${defaultHostname} at runtime when cluster details are known.
  fitConfigs: [
    {
      id: 'fit-config-0',
      config: {
        // fit-cli fills ${defaultHostname} (and rest.hostname) in at runtime once the cluster is up.
        clusterAccess: {
          connectionString: 'couchbase://${defaultHostname}',
          username: 'Administrator',
          password: 'password',
          tls: null,
          rest: {
            hostname: '${defaultHostname}',
            resolveDnsSrv: false,
          },
          proxy: {
            hostname: 'host.docker.internal',
          },
        },
        // numReplicas >= 1 is required for FTS tests to pass.
        bucketConfig: {
          numReplicas: 1,
          bucketType: 'couchbase',
          storage: 'couchstore',
        },
        excludeTests: [
          'situational',
        ],
      },
    },
  ],
}
