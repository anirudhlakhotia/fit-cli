// Only one Enterprise Analytics build/topology is currently supported, so this is
// identical to enterprise-analytics-func-release — kept separate for naming
// consistency across axes, and as the natural place to add situational coverage later.
{
  preset: {
    order: 20,
    tags: ['enterprise-analytics', 'functional'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'analytics-functional',
                  fitConfig: 'fit-config-0',
                  tests: {
                    presets: ['all'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          // cbdino wire flag: `columnar: true` builds a self-managed Enterprise
          // Analytics cluster; the docker deployer fronts it with an nginx load balancer.
          columnar: true,
          nodes: [
            {
              count: 3,
              version: '{{environments.defaults.enterpriseAnalyticsVersion}}',
            },
          ],
          docker: {
            'passive-load-balancer': true,
            'use-dino-certs': true,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],
  fitConfigs: [
    {
      id: 'fit-config-0',
      config: {
        clusterAccess: {
          // The driver connects classically for admin (filled in by fit-cli); the
          // SDK/performer reaches Analytics through the load balancer's query port.
          clusterParams: {
            loadBalancedCluster: {
              ports: [8095, 18095],
            },
          },
          performer: {
            connectionString: 'http://${defaultHostname}:8095',
            tls: null,
          },
        },
      },
    },
  ],
}
