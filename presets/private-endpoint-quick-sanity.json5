{
  preset: {
    order: 15,
    description: 'Quick sanity for private endpoint (PrivateLink) testing. Requires the cb-qe AWS account and sdkqe-github-runners-tf infrastructure.',
    expectedTime: '< 10 minutes'
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {
        // Attach the cbqerunners-vpc default SG (intra-VPC) and the qerunner IAM profile
        // so the FIT test can create a Capella private endpoint at runtime.
        privateEndpoint: {},
      },
      setup: {
        capellaEnvironment: 'dev',
      },
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    classes: ['com.couchbase.client.kv.SanityTest'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],
}
