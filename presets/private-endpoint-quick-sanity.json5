{
  preset: {
    order: 15,
    description: 'Quick sanity for private endpoint (PrivateLink) testing against a real Capella cluster on AWS. Runs in the normal fit-cli AWS account.',
    tags: ['private-endpoint'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {
        // Places the instance in the fit-cli VPC's default SG so it can reach the
        // Capella PrivateLink endpoint, which lands in the same SG.
        privateEndpoint: {},
      },
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    classes: ['com.couchbase.client.kv.SanityTest'],
                  },
                },
              ],
            },
          ],
        },
      ],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                classes: ['com.couchbase.situational.tests.SanityTest'],
                addToDefaultExcludedGroups: ['protostellarWillWorkLater']
              },
              situational: {
                database: {
                  mode: 'hosted',
                  // 'dev' as quick sanity testing
                  resultsEnvironment: 'dev',
                },
                privateEndpoint: {},
              },
            },
          ],
        },
      ]
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '7.6',
            },
          ],
          cloud: {
            'cloud-provider': 'aws',
          },
        },
        onClusterExists: 'useExisting',
        capella: {
          cloudProvider: 'aws',
          environment: 'dev',
          privateEndpoint: {},
        },
      },
    },
  ],
}
