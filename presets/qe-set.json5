{
  preset: {
    order: 5,
    description: 'This is the set SDKQE-that-was like to run before signing off on a release.',
    tags: ['qe-set'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      setup: {
        capellaEnvironment: 'prod',
      },
      clusters: [
        {
          clusterConfig: '8.0-stable',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['all'],
                  },
                },
              ],
            },
          ],
        },
        {
          clusterConfig: '7.6-stable',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['all'],
                  },
                },
              ],
            },
          ],
        },
      ],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                presets: ['standard-qe'],
              },
              situational: {
                database: {
                  mode: 'hosted',
                  resultsEnvironment: 'dev',
                },
              },
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: '8.0-stable',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
    {
      id: '7.6-stable',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '7.6-stable',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],
}
