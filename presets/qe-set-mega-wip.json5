{
  preset: {
    order: 5,
    description: 'This is the set SDKQE-that-was like to run before signing off on a release.  (WIP of a bigger set including CNG)',
    expectedTime: 'Quite long',
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      setup: {
        capellaEnvironment: 'prod',
      },
      clusters: [
        {
          // Functional operational testing.
          clusterConfig: 'operational',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: [
                      'all'
                    ],
                  },
                },
              ],
            },
          ],
        },
        {
          // CNG operational testing.
          clusterConfig: 'cng',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  fitConfig: 'cng-fit-config',
                  tests: {
                    presets: [
                      'all'
                    ],
                    addToDefaultExcludedGroups: [
                      'protostellarWillWorkLater'
                    ],
                  },
                }
              ],
            },
          ],
        }
      ],
      // Situational operational testing.
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                presets: [
                  'standard-qe'
                ],
              },
              situational: {
                database: {
                  mode: 'hosted',
                  resultsEnvironment: 'dev',
                },
              },
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'operational',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '8.0-stable',
              services: [
                'kv',
                'n1ql',
                'index',
                'fts'
              ],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'destroyAndRecreate',
      },
    },
    {
      id: 'cng',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: "8.0.2-5503",
              services: [
                'kv',
                'n1ql',
                'index',
                'fts'
              ],
            },
          ],
          cao: {
            'operator-version': '2.9.2',
            'gateway-version': '1.1.0-135',
          },
        },
        onClusterExists: 'destroyAndRecreate',
      },
    }
  ],
  fitConfigs: [
    {
      id: 'cng-fit-config',
      connection: {
        scheme: 'couchbase2',
        tls: {
          insecure: true
        },
      },
      config: {
        excludeTests: [
          'ssh',
          'openshift'
        ],
      },
    },
  ]
}
