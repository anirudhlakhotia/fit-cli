{
  preset: {
    order: 15,
    description: 'Functional and situational testing for private endpoint (PrivateLink) testing against a real Capella cluster on AWS.',
    expectedTime: '~15 minutes',
    tags: ['private-endpoint', 'functional', 'situational'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {
        privateEndpoint: {},
      },
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'reuse',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['all']
                  },
                },
              ],
            },
          ],
        },
      ],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                presets: ['standard-qe']
              },
              situational: {
                database: {
                  mode: 'hosted',
                  // 'dev' as quick sanity testing
                  resultsEnvironment: 'dev',
                },
              },
            },
          ],
        },
      ]
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '7.6',
            },
          ],
          cloud: {
            'cloud-provider': 'aws',
          },
        },
        onClusterExists: 'useExisting',
        capella: {
          cloudProvider: 'aws',
          environment: 'dev',
          // Sets up an AWS PrivateLink connection to this cluster after allocation,
          // and connects the FIT test-driver/performer over it instead of the public endpoint.
          privateEndpoint: {},
        },
      },
    },
  ],
}
