{
  preset: {
    order: 30,
    tags: ['capella', 'situational'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      setup: {
        capellaEnvironment: 'prod',
      },
      clusters: [],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                presets: ['{{environments.testSets.SITUATIONAL_SET_RELEASE}}'],
              },
              situational: {
                database: {
                  mode: 'hosted',
                  resultsEnvironment: 'prod',
                },
              },
              versions: ['{{environments.defaults.capellaClusterVersion}}', '{{environments.defaults.capellaPreviousClusterVersion}}'],
            },
          ],
        },
      ],
    },
  ],
}
