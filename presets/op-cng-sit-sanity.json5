{
  preset: {
    order: 10,
    tags: ['cng', 'situational'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      clusters: [],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                classes: ['com.couchbase.situational.tests.CngTest#rebalance3To4NodesDuringMixedKv'],
              },
              situational: {
                database: {
                  mode: 'hosted',
                  resultsEnvironment: 'prod',
                },
                cng: {},
              },
            },
          ],
        },
      ],
    },
  ],
}
